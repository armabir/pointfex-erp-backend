# ==============================================================================
# Pointfex ERP Backend — Environment Template (.env.example)
# Copy to .env for local development. NEVER commit .env or real secrets.
# ==============================================================================

# --- App (REQUIRED) -----------------------------------------------------------
# development | production | test (DEV: development, PROD: production)
NODE_ENV="development"
# HTTP port for NestJS API (DEV/PROD: 3000)
PORT=3000

# --- Database (REQUIRED) ------------------------------------------------------
# Pooled runtime connection. On Neon, connect as the limited `pointfex_app` role
# with `?sslmode=require&pgbouncer=true&connect_timeout=15`.
DATABASE_URL="postgresql://pointfex_app:REPLACE_WITH_PASSWORD@localhost:5432/pointfex_erp?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct unpooled owner connection for Prisma CLI migrations ONLY (never used at runtime).
DIRECT_URL="postgresql://db_owner:REPLACE_WITH_PASSWORD@localhost:5432/pointfex_erp?sslmode=require"

# --- Authentication & Cookies (REQUIRED) --------------------------------------
# Minimum 32 random characters in production (`openssl rand -hex 32`).
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Short-lived access token TTL (DEV/PROD: 15m).
JWT_EXPIRES_IN="15m"
# Refresh cookie lifetime in days (DEV/PROD: 7).
JWT_REFRESH_EXPIRES_DAYS="7"
# true under HTTPS in production; false only for plain HTTP localhost.
COOKIE_SECURE="false"
# Use `none` with secure cookies when frontend and backend use separate HTTPS origins.
COOKIE_SAME_SITE="strict"

# --- Authorization & Network Security -----------------------------------------
# enforce | shadow | legacy (PROD: enforce)
AUTHZ_MODE="enforce"
PBAC_MODE="enforce"
# Fixed CEO transfer control (default false - transfer disabled)
CEO_TRANSFER_ENABLED="false"
# Automated cron sweeper secret token
CRON_SECRET=""
# Executive voting deadline in days (default 7)
VOTE_DEADLINE_DAYS="7"
# Comma-separated allowed frontend origins; NEVER use * (DEV: http://localhost:5173).
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Set false in production; true only for local load/dev testing.
THROTTLE_BYPASS="false"
# Optional comma-separated IPv4/IPv6 addresses blocked at the API boundary.
BLOCKED_IPS=""

# --- Transactional Email via Resend (REQUIRED in PROD, OPTIONAL in DEV) -------
# Resend API key for welcome, password-reset, and MFA-reset emails.
RESEND_API_KEY=""
# Verified sender address (or Resend test sender for your own email during setup).
MAIL_FROM="Pointfex ERP <no-reply@pointfex.internal>"
# Lifetime in hours for temporary onboarding and admin-reset passwords (default: 24).
TEMP_PASSWORD_TTL_HOURS="24"

# --- Google Sign-In OAuth 2.0 (OPTIONAL in DEV, REQUIRED if Google enabled) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/api/auth/google/callback"

# --- Frontend & Login Allowlist Rules -----------------------------------------
# Frontend base URL used for email links and OAuth redirects.
FRONTEND_URL="http://localhost:5173"
# Set true in production after adding CEO + initial emails to `login_allowlist`.
LOGIN_ALLOWLIST_REQUIRED="false"
# Keep false to enforce exact verified email matching (never strip +tags or dots).
ALLOW_DOMAIN_RULES="false"

# --- First-Time Seeding ONLY (REMOVE after initial seed in production) --------
# production | demo (Demo seed refuses non-localhost unless ALLOW_DEMO_SEED=true)
SEED_PROFILE="production"
ALLOW_DEMO_SEED="false"
CEO_EMAIL=""
CEO_INITIAL_PASSWORD=""
SEED_DEFAULT_PASSWORD=""

# --- Optional Redis & Object Storage (UNUSED by default) ----------------------
REDIS_URL=""
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
S3_BUCKET=""
