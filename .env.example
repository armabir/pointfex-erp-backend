# Pointfex ERP Backend Environment Configuration
PORT=3000
NODE_ENV=development

# Database Connection URL (PostgreSQL / Neon)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/pointfex_erp?schema=public"
DIRECT_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/pointfex_erp?schema=public"

# Object Storage (AWS S3 Compatible — Optional)
AWS_ENDPOINT_URL_S3="https://REPLACE_WITH_S3_ENDPOINT"
AWS_ACCESS_KEY_ID="REPLACE_WITH_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="REPLACE_WITH_SECRET_ACCESS_KEY"
AWS_REGION="ap-southeast-1"
S3_BUCKET="REPLACE_WITH_BUCKET_NAME"

# Strictly Allowed CORS Origins (comma-separated, never use *)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Optional comma-separated IPv4/IPv6 addresses to block at the network boundary
BLOCKED_IPS=""

# Rate limiter bypass toggle (false in production; set true only for local dev/testing)
THROTTLE_BYPASS=false

# JWT Signing Configuration (Required - minimum 32 chars in production)
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS="7"

# Set to true under HTTPS in production; false only for plain HTTP local development
COOKIE_SECURE="true"

# Optional Redis connection string for distributed RBAC cache
# REDIS_URL="redis://redis:6379"

# PBAC Security Mode: enforce | shadow | legacy
PBAC_MODE="enforce"

# Database Seeding Credential (Required for running prisma:seed)
SEED_DEFAULT_PASSWORD="REPLACE_BEFORE_SEEDING"
